{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nishide-dev/h3fast/schemas/quality-reference.schema.json",
  "title": "H3Fast exact quality reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reference_id",
    "method",
    "source",
    "expected",
    "baseline_statistics",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "reference_id": { "type": "string", "minLength": 1, "pattern": "^[^\\s]+$" },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "video_decode_format",
        "audio_decode_format",
        "ffmpeg_version",
        "ffprobe_version"
      ],
      "properties": {
        "id": { "const": "exact-decoded-artifact-v1" },
        "profile": { "const": "exact" },
        "video_decode_format": { "const": "rgb24" },
        "audio_decode_format": { "const": "pcm_s16le" },
        "ffmpeg_version": { "type": "string", "minLength": 1 },
        "ffprobe_version": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "protocol_identity",
        "suite_completed_at",
        "measured_runs",
        "prompt_sha256",
        "request_sha256",
        "sglang_commit"
      ],
      "properties": {
        "protocol_id": { "type": "string", "minLength": 1 },
        "protocol_identity": { "$ref": "#/$defs/protocol_identity" },
        "suite_completed_at": { "type": "string", "format": "date-time" },
        "measured_runs": { "type": "integer", "minimum": 3 },
        "prompt_sha256": { "$ref": "#/$defs/sha256" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "sglang_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "expected": { "$ref": "#/$defs/observation" },
    "baseline_statistics": { "$ref": "#/$defs/statistics_set" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "protocol_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "task_family",
        "task",
        "case_id",
        "prompt_sha256",
        "case_sha256"
      ],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "task_family": { "type": "string", "minLength": 1 },
        "task": { "type": "string", "minLength": 1 },
        "case_id": { "type": "string", "minLength": 1 },
        "prompt_sha256": { "$ref": "#/$defs/sha256" },
        "case_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_sha256",
        "artifact_size",
        "video_decoded_sha256",
        "audio_decoded_sha256",
        "media"
      ],
      "properties": {
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_size": { "type": "integer", "minimum": 1 },
        "video_decoded_sha256": { "$ref": "#/$defs/sha256" },
        "audio_decoded_sha256": { "$ref": "#/$defs/sha256" },
        "media": { "$ref": "#/$defs/media" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video", "audio", "container", "av_duration_drift_seconds"],
      "properties": {
        "video": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codec",
            "pixel_format",
            "width",
            "height",
            "frame_rate",
            "duration_seconds",
            "frames"
          ],
          "properties": {
            "codec": { "type": "string", "minLength": 1 },
            "pixel_format": { "type": "string", "minLength": 1 },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "frame_rate": { "type": "string", "minLength": 1 },
            "duration_seconds": { "type": "number", "minimum": 0 },
            "frames": { "type": "integer", "minimum": 1 }
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codec",
            "sample_rate_hz",
            "channels",
            "duration_seconds",
            "frames"
          ],
          "properties": {
            "codec": { "type": "string", "minLength": 1 },
            "sample_rate_hz": { "type": "integer", "minimum": 1 },
            "channels": { "type": "integer", "minimum": 1 },
            "duration_seconds": { "type": "number", "minimum": 0 },
            "frames": { "type": "integer", "minimum": 1 }
          }
        },
        "container": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "duration_seconds"],
          "properties": {
            "format": { "type": "string", "minLength": 1 },
            "duration_seconds": { "type": "number", "minimum": 0 }
          }
        },
        "av_duration_drift_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "p5", "p50", "p95", "max"],
      "properties": {
        "min": { "type": "number", "minimum": 0 },
        "p5": { "type": "number", "minimum": 0 },
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 }
      }
    },
    "statistics_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_size",
        "video_duration_seconds",
        "video_frames",
        "audio_duration_seconds",
        "audio_frames",
        "container_duration_seconds",
        "av_duration_drift_seconds"
      ],
      "properties": {
        "artifact_size": { "$ref": "#/$defs/statistics" },
        "video_duration_seconds": { "$ref": "#/$defs/statistics" },
        "video_frames": { "$ref": "#/$defs/statistics" },
        "audio_duration_seconds": { "$ref": "#/$defs/statistics" },
        "audio_frames": { "$ref": "#/$defs/statistics" },
        "container_duration_seconds": { "$ref": "#/$defs/statistics" },
        "av_duration_drift_seconds": { "$ref": "#/$defs/statistics" }
      }
    }
  }
}
