{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nishide-dev/h3fast/schemas/private-human-pairwise-ballot.schema.json",
  "title": "H3Fast private human-pairwise ballot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ballot_id",
    "status",
    "formal_set_sha256",
    "assignment_sha256",
    "reviewer",
    "created_at",
    "completed_at",
    "protocol",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "ballot_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pending", "completed"] },
    "formal_set_sha256": { "$ref": "#/$defs/sha256" },
    "assignment_sha256": { "$ref": "#/$defs/sha256" },
    "reviewer": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blinding",
        "randomization",
        "missing_observation_policy",
        "tie_policy",
        "score"
      ],
      "properties": {
        "blinding": { "const": "a-b-hidden-assignment-v1" },
        "randomization": { "const": "per-case-sha256-order-v1" },
        "missing_observation_policy": { "const": "fail" },
        "tie_policy": { "const": "neutral" },
        "score": { "const": "candidate-minus-baseline-win-rate-v1" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "pending" } }, "required": ["status"] },
      "then": {
        "properties": {
          "completed_at": { "type": "null" },
          "cases": {
            "items": {
              "properties": { "selection": { "type": "null" } },
              "required": ["selection"]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "completed_at": { "type": "string", "format": "date-time" },
          "cases": {
            "items": {
              "properties": { "selection": { "enum": ["a", "b", "tie"] } },
              "required": ["selection"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "presentations",
        "assignment_commitment_sha256",
        "selection"
      ],
      "properties": {
        "case_id": { "type": "string", "pattern": "^(smoke|regression)-[0-9]{3}$" },
        "presentations": {
          "type": "array",
          "prefixItems": [{ "const": "a" }, { "const": "b" }],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "assignment_commitment_sha256": { "$ref": "#/$defs/sha256" },
        "selection": { "type": ["string", "null"] }
      }
    }
  }
}
