{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nishide-dev/h3fast/schemas/benchmark-result.schema.json",
  "title": "H3Fast benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "case_id",
    "job_id",
    "status",
    "started_at",
    "completed_at",
    "elapsed_seconds",
    "prompt_sha256",
    "request",
    "artifact"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "protocol_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "status": { "const": "completed" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "elapsed_seconds": { "type": "number", "minimum": 0 },
    "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "request": { "type": "object" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inference_time_seconds": { "type": "number", "minimum": 0 },
        "peak_memory_mib": { "type": "number", "minimum": 0 },
        "media_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "seconds"],
          "properties": {
            "size": { "type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$" },
            "seconds": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" }
          }
        },
        "performance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pipeline_total_seconds",
            "stages",
            "denoise_steps_seconds"
          ],
          "properties": {
            "pipeline_total_seconds": { "type": "number", "minimum": 0 },
            "stages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "seconds"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "seconds": { "type": "number", "minimum": 0 }
                }
              }
            },
            "denoise_steps_seconds": {
              "type": "array",
              "items": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
