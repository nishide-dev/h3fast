{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nishide-dev/h3fast/schemas/private-human-pairwise-assignment.schema.json",
  "title": "H3Fast private human-pairwise assignment key",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ballot_id",
    "formal_set_sha256",
    "randomization_seed_sha256",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "ballot_id": { "type": "string", "minLength": 1 },
    "formal_set_sha256": { "$ref": "#/$defs/sha256" },
    "randomization_seed_sha256": { "$ref": "#/$defs/sha256" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "a_source",
        "salt",
        "assignment_commitment_sha256"
      ],
      "properties": {
        "case_id": { "type": "string", "pattern": "^(smoke|regression)-[0-9]{3}$" },
        "a_source": { "enum": ["baseline", "candidate"] },
        "salt": { "$ref": "#/$defs/sha256" },
        "assignment_commitment_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
