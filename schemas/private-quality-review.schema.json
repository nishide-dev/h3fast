{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nishide-dev/h3fast/schemas/private-quality-review.schema.json",
  "title": "H3Fast private quality registry review",
  "description": "Local-only rights and selection decisions. Do not commit instances of this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "source_registry_sha256",
    "registry_content_sha256",
    "prepared_at",
    "reviewer",
    "reviewed_at",
    "selection",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "registry_id": { "const": "h3fast-phase0-formal-quality-v1" },
    "source_registry_sha256": { "$ref": "#/$defs/sha256" },
    "registry_content_sha256": { "$ref": "#/$defs/sha256" },
    "prepared_at": { "type": "string", "format": "date-time" },
    "reviewer": { "type": "string", "minLength": 1 },
    "reviewed_at": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_decision",
        "exclusions_decision",
        "known_failures_decision",
        "notes"
      ],
      "properties": {
        "method_decision": { "$ref": "#/$defs/decision" },
        "exclusions_decision": { "$ref": "#/$defs/decision" },
        "known_failures_decision": { "$ref": "#/$defs/decision" },
        "notes": { "type": "string" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decision": { "enum": ["pending", "approved", "rejected"] },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "rights_decision": { "const": "approved" } },
            "required": ["rights_decision"]
          },
          "then": {
            "properties": { "rights_evidence": { "minItems": 1 } }
          },
          "else": {
            "properties": { "rights_evidence": { "maxItems": 0 } }
          }
        }
      ],
      "required": [
        "id",
        "prompt_sha256",
        "reference_asset_sha256s",
        "rights_decision",
        "selection_decision",
        "rights_evidence",
        "notes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^(smoke|regression)-[0-9]{3}$" },
        "prompt_sha256": { "$ref": "#/$defs/sha256" },
        "reference_asset_sha256s": {
          "type": "array",
          "items": { "$ref": "#/$defs/sha256" }
        },
        "rights_decision": { "$ref": "#/$defs/decision" },
        "selection_decision": { "$ref": "#/$defs/decision" },
        "rights_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
