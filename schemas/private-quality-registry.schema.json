{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nishide-dev/h3fast/schemas/private-quality-registry.schema.json",
  "title": "H3Fast private formal quality registry",
  "description": "Local-only prompt and reference-asset registry. Do not commit instances of this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "updated_at", "selection", "cases"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "registry_id": { "const": "h3fast-phase0-formal-quality-v1" },
    "updated_at": { "type": "string", "format": "date" },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "exclusions_reviewed",
        "public_exclusions",
        "known_failures_reviewed",
        "public_known_failures"
      ],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "exclusions_reviewed": { "type": "boolean" },
        "public_exclusions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "known_failures_reviewed": { "type": "boolean" },
        "public_known_failures": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "split": { "const": "smoke" } },
            "required": ["split"]
          },
          "then": {
            "properties": { "id": { "pattern": "^smoke-[0-9]{3}$" } }
          },
          "else": {
            "properties": { "id": { "pattern": "^regression-[0-9]{3}$" } }
          }
        },
        {
          "if": {
            "properties": { "task": { "const": "t2va" } },
            "required": ["task"]
          },
          "then": {
            "properties": { "references": { "maxItems": 0 } }
          },
          "else": {
            "properties": { "references": { "minItems": 1 } }
          }
        },
        {
          "if": {
            "properties": { "rights_status": { "const": "approved" } },
            "required": ["rights_status"]
          },
          "then": {
            "properties": { "rights_evidence": { "minItems": 1 } }
          },
          "else": {
            "properties": { "rights_evidence": { "maxItems": 0 } }
          }
        }
      ],
      "required": [
        "id",
        "split",
        "prompt",
        "seed",
        "task",
        "duration_seconds",
        "aspect_ratio",
        "languages",
        "subject_tags",
        "motion_tags",
        "audio_tags",
        "references",
        "rights_status",
        "rights_evidence",
        "public_notes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^(smoke|regression)-[0-9]{3}$" },
        "split": { "enum": ["smoke", "regression"] },
        "prompt": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer", "minimum": 0 },
        "task": { "enum": ["t2va", "fl2va", "ref2va"] },
        "duration_seconds": { "enum": [4, 5, 10, 15] },
        "aspect_ratio": { "enum": ["landscape", "square", "portrait"] },
        "languages": { "$ref": "#/$defs/stringArray" },
        "subject_tags": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["face", "hands", "text", "product", "multiple-people"] },
          "uniqueItems": true
        },
        "motion_tags": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["dynamic", "static", "camera-movement"] },
          "uniqueItems": true
        },
        "audio_tags": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["dialogue", "environment", "music", "near-silent"] },
          "uniqueItems": true
        },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" }
        },
        "rights_status": { "enum": ["approved", "unreviewed"] },
        "rights_evidence": {
          "type": "array",
          "items": { "type": "string", "format": "uri", "pattern": "^https://" },
          "uniqueItems": true
        },
        "public_notes": { "type": "string", "minLength": 1 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "modality"],
      "properties": {
        "path": {
          "description": "Local path resolved relative to the private registry; never copied to public output.",
          "type": "string",
          "minLength": 1
        },
        "modality": { "enum": ["image", "video", "audio"] }
      }
    }
  }
}
