{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nishide-dev/h3fast/schemas/quality-registry-attestation.schema.json",
  "title": "H3Fast redacted quality-registry attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attestation_id",
    "registry_id",
    "registry_sha256",
    "created_at",
    "source_issue",
    "selection_method",
    "counts",
    "rights_review",
    "private_artifacts",
    "redaction",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "attestation_id": { "const": "h3fast-phase0-formal-quality-registry-v1" },
    "registry_id": { "const": "h3fast-phase0-formal-quality-v1" },
    "registry_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "source_issue": { "type": "string", "format": "uri", "pattern": "^https://" },
    "selection_method": { "type": "string", "minLength": 1 },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smoke", "regression", "total"],
      "properties": {
        "smoke": { "const": 10 },
        "regression": { "const": 50 },
        "total": { "const": 60 }
      }
    },
    "rights_review": { "const": "pending" },
    "private_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "committed", "uploaded"],
      "properties": {
        "storage": { "const": "repository-external" },
        "committed": { "const": false },
        "uploaded": { "const": false }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_text_present", "reference_paths_present", "media_present"],
      "properties": {
        "prompt_text_present": { "const": false },
        "reference_paths_present": { "const": false },
        "media_present": { "const": false }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
