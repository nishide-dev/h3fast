{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nishide-dev/h3fast/schemas/benchmark-suite.schema.json",
  "title": "H3Fast measured benchmark suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "case_id",
    "status",
    "started_at",
    "completed_at",
    "warmup_runs",
    "measured_runs",
    "server_lifecycle",
    "guard",
    "runs",
    "aggregate"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "protocol_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "status": { "const": "completed" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "warmup_runs": { "type": "integer", "minimum": 0 },
    "measured_runs": { "type": "integer", "minimum": 1 },
    "server_lifecycle": { "type": "object" },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "failure_report_present"],
      "properties": {
        "status": { "const": "passed" },
        "failure_report_present": { "const": false }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "kind", "status", "result"],
        "properties": {
          "label": { "type": "string", "pattern": "^(warmup|measured)-[0-9]{3}$" },
          "kind": { "enum": ["warmup", "measured"] },
          "status": { "const": "completed" },
          "result": { "type": "object" }
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_elapsed_seconds",
        "server_inference_seconds",
        "pipeline_total_seconds",
        "peak_gpu_memory_mib",
        "stages_seconds",
        "dominant_stage"
      ],
      "properties": {
        "client_elapsed_seconds": { "$ref": "#/$defs/statistics" },
        "server_inference_seconds": { "$ref": "#/$defs/statistics" },
        "pipeline_total_seconds": { "$ref": "#/$defs/statistics" },
        "peak_gpu_memory_mib": { "$ref": "#/$defs/statistics" },
        "stages_seconds": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/statistics" }
        },
        "dominant_stage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "p50_seconds"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "p50_seconds": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  },
  "$defs": {
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "p50", "p95", "max"],
      "properties": {
        "min": { "type": "number", "minimum": 0 },
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 }
      }
    }
  }
}
