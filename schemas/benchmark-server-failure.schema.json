{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nishide-dev/h3fast/schemas/benchmark-server-failure.schema.json",
  "title": "H3Fast guarded benchmark server failure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "started_at",
    "recorded_at",
    "selected_gpus",
    "server_pid",
    "error",
    "foreign_processes"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "status": { "const": "failed" },
    "started_at": { "type": "string", "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "selected_gpus": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 },
      "uniqueItems": true
    },
    "server_pid": { "type": "integer", "minimum": 1 },
    "error": { "type": "string", "minLength": 1 },
    "foreign_processes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gpu_index",
          "gpu_uuid",
          "pid",
          "process_name",
          "used_memory_mib"
        ],
        "properties": {
          "gpu_index": { "type": "integer", "minimum": 0 },
          "gpu_uuid": { "type": "string", "minLength": 1 },
          "pid": { "type": "integer", "minimum": 1 },
          "process_name": { "type": "string", "minLength": 1 },
          "used_memory_mib": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
