{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nishide-dev/h3fast/schemas/quality-metric-plan.schema.json",
  "title": "H3Fast formal quality metric plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "status",
    "updated_at",
    "source_issue",
    "quality_profile",
    "evaluation",
    "metrics",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "plan_id": { "const": "h3fast-phase0-formal-quality-metrics-v1" },
    "status": { "enum": ["draft", "approved"] },
    "updated_at": { "type": "string", "format": "date" },
    "source_issue": { "type": "string", "format": "uri", "pattern": "^https://" },
    "quality_profile": { "const": "exact" },
    "evaluation": { "$ref": "#/$defs/evaluation" },
    "metrics": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/metric" }
    },
    "limitations": { "$ref": "#/$defs/nonemptyUniqueStrings" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$" },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonemptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_repetitions",
        "candidate_repetitions",
        "statistics",
        "comparison",
        "family_aggregation",
        "missing_observation_policy"
      ],
      "properties": {
        "baseline_repetitions": { "const": 3 },
        "candidate_repetitions": { "const": 3 },
        "statistics": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["p5", "p50", "p95", "worst-case"] }
        },
        "comparison": { "const": "baseline-self-envelope-v1" },
        "family_aggregation": { "const": "independent-all-must-pass" },
        "missing_observation_policy": { "const": "fail" },
        "deterministic_generation_exemption": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "verified_repetitions",
            "owner",
            "verified_at",
            "evidence"
          ],
          "properties": {
            "policy": { "const": "bit-exact-digest-match-v1" },
            "verified_repetitions": { "type": "integer", "minimum": 2 },
            "owner": { "type": "string", "minLength": 1 },
            "verified_at": { "type": "string", "format": "date" },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "revision",
        "entrypoint",
        "dependencies",
        "inputs",
        "score_direction"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/sha256" },
        "entrypoint": { "type": "string", "minLength": 1 },
        "dependencies": { "$ref": "#/$defs/nonemptyUniqueStrings" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "prompt",
              "reference-media",
              "baseline-video",
              "baseline-audio",
              "candidate-video",
              "candidate-audio",
              "human-ballot"
            ]
          }
        },
        "score_direction": {
          "enum": ["higher-is-better", "lower-is-better", "two-sided"]
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "unit",
        "absolute_tolerance",
        "relative_tolerance",
        "minimum_case_coverage",
        "aggregation",
        "failure_policy",
        "notes"
      ],
      "properties": {
        "method": { "const": "baseline-self-envelope-v1" },
        "unit": { "type": "string", "minLength": 1 },
        "absolute_tolerance": { "const": 0 },
        "relative_tolerance": { "const": 0 },
        "minimum_case_coverage": { "const": 1 },
        "aggregation": { "const": "per-case-all-runs" },
        "failure_policy": { "const": "any-family-fails" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "unassigned" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "owner": { "type": "null" },
              "implementation": { "type": "null" },
              "budget": { "type": "null" },
              "evidence": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "const": "planned" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "owner": { "type": "string", "minLength": 1 },
              "implementation": { "$ref": "#/$defs/implementation" },
              "evidence": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "const": "approved" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "owner": { "type": "string", "minLength": 1 },
              "implementation": { "$ref": "#/$defs/implementation" },
              "budget": { "$ref": "#/$defs/budget" },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "format": "uri", "pattern": "^https://" }
              }
            }
          }
        }
      ],
      "required": [
        "family",
        "state",
        "owner",
        "implementation",
        "budget",
        "evidence"
      ],
      "properties": {
        "family": {
          "enum": [
            "audio-quality",
            "av-sync",
            "human-pairwise",
            "perceptual-video",
            "prompt-adherence",
            "temporal-consistency"
          ]
        },
        "state": { "enum": ["unassigned", "planned", "approved"] },
        "owner": { "type": ["string", "null"], "minLength": 1 },
        "implementation": {
          "oneOf": [
            { "$ref": "#/$defs/implementation" },
            { "type": "null" }
          ]
        },
        "budget": {
          "oneOf": [
            { "$ref": "#/$defs/budget" },
            { "type": "null" }
          ]
        },
        "evidence": { "$ref": "#/$defs/uniqueStrings" }
      }
    }
  }
}
