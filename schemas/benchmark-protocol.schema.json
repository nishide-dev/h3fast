{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nishide-dev/h3fast/schemas/benchmark-protocol.schema.json",
  "title": "H3Fast benchmark protocol",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "status",
    "unresolved",
    "base_model",
    "environment",
    "measurement",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "protocol_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "ready"] },
    "unresolved": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "base_model": { "type": "object" },
    "environment": { "type": "object" },
    "measurement": { "type": "object" },
    "cases": { "type": "array", "minItems": 1 }
  }
}
