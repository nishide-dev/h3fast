{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nishide-dev/h3fast/schemas/benchmark-protocol.schema.json",
  "title": "H3Fast benchmark protocol",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "status",
    "unresolved",
    "base_model",
    "environment",
    "runtime",
    "measurement",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "protocol_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "ready"] },
    "unresolved": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "base_model": { "type": "object" },
    "environment": { "type": "object" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dit_layerwise_resident_layers"],
      "properties": {
        "dit_layerwise_resident_layers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    },
    "measurement": { "type": "object" },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "reference_path",
        "method",
        "profile",
        "baseline_measured_runs",
        "video_decode_format",
        "audio_decode_format",
        "scope",
        "formal_quality_set_ready"
      ],
      "properties": {
        "reference_id": { "type": "string", "minLength": 1 },
        "reference_path": { "type": "string", "minLength": 1 },
        "method": { "const": "exact-decoded-artifact-v1" },
        "profile": { "const": "exact" },
        "baseline_measured_runs": { "type": "integer", "minimum": 3 },
        "video_decode_format": { "const": "rgb24" },
        "audio_decode_format": { "const": "pcm_s16le" },
        "scope": { "type": "string", "minLength": 1 },
        "formal_quality_set_ready": { "type": "boolean" }
      }
    },
    "cases": { "type": "array", "minItems": 1 }
  }
}
